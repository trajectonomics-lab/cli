{
	"name": "@trajectonomics-lab/cli",
	"version": "0.0.0",
	"private": true,
	"description": "trajectonomics command line",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"bin": {
		"traj": "./src/index.ts"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome ci --error-on-warnings .",
		"format": "biome check --write .",
		"build": "bun build src/index.ts --compile --outfile dist/traj",
		"check": "bun run lint && bun run typecheck && bun test && bun run build",
		"update:skills": "bunx skills@latest update -p -y"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
